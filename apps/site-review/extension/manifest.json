{
  "manifest_version": 3,
  "name": "FGS Site Review",
  "version": "1.0.0",
  "minimum_chrome_version": "112",
  "description": "Leave feedback on the website you're browsing or share a screenshot your client can review on their phone.",
  "key": "",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://sitereview.fernandezgrowthsystems.com/*"],
  "background": {"service_worker": "worker.js"},
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "action": {
    "default_title": "FGS Site Review",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}
  }
}
